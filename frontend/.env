# Copie este arquivo para ".env" e ajuste os valores.

# Endereço da API Python (FastAPI)
VITE_API_URL=http://localhost:8000

# Endereço da API Java de análises (Spring Boot)
VITE_ANALYTICS_URL=http://localhost:8085

# true  = usa dados falsos (mocks), não precisa do back-end rodando
# false = usa as APIs reais (VITE_API_URL e VITE_ANALYTICS_URL)
VITE_USE_MOCK=true
