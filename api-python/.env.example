# Copie este arquivo para ".env" (dentro de api-python/).
# O ".env" não vai para o git, porque guarda a chave secreta.

# Chave usada para assinar os tokens de login (JWT). Obrigatória.
# Pode ser qualquer texto longo; troque por um valor seu.
SECRET_KEY="troque-esta-chave-por-um-texto-longo-e-aleatorio"

# Os valores abaixo já são os padrões do código; só mude se precisar.
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL="sqlite:///./quotly.db"
PROJECT_NAME="Quotly API"
