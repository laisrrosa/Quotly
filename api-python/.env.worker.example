# Copie para `.env.worker` (NÃO para o `.env` do back-end) e preencha.
# O `.env.worker` não vai para o git (tem senhas). Está separado do `.env` porque
# o back-end recusa variáveis que ele não conhece e deixaria de subir.

# ----------------------------------------------------------------- Cotações
# Ordem de tentativa dos provedores (o próximo é usado se o anterior falhar).
MARKET_PROVIDERS=brapi,yfinance
# Token gratuito em https://brapi.dev/dashboard
# (sem token a brapi só responde PETR4, VALE3, MGLU3 e ITUB4)
BRAPI_TOKEN=
# Tempo de cache em segundos
QUOTE_CACHE_TTL=60
HISTORY_CACHE_TTL=900
MARKET_HTTP_TIMEOUT=10

# ------------------------------------------------------------------- E-mail
# console = só mostra o e-mail no log | smtp = envia de verdade
EMAIL_BACKEND=console
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 587 -> SMTP_USE_TLS=true | 465 -> SMTP_USE_SSL=true
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=alertas@quotly.local
EMAIL_FROM_NAME=Quotly
# Endereço do front-end (vira o link "Abrir o Quotly" no e-mail)
APP_URL=http://localhost:5173
DISPLAY_TIMEZONE=America/Sao_Paulo

# ------------------------------------------------------------------- Worker
ALERT_CHECK_INTERVAL_MINUTES=5
# Onde ficam os modelos e a sessão do banco no back-end (formato modulo:Nome).
# Os valores abaixo já são os do back-end atual; só mude se renomearem algo.
ALERT_MODEL_PATH=app.models:Alert
USER_MODEL_PATH=app.models:User
STOCK_MODEL_PATH=app.models:StockQuote
DB_SESSION_FACTORY_PATH=app.database.session:SessionLocal

# --------------------------------------------------------------------- Logs
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
